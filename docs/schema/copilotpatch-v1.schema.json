{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyDataIntelligence/pycharmToCopilot/copilotpatch-v1.schema.json",
  "title": "Copilot Context Bridge change set",
  "type": "object",
  "required": ["formatVersion", "repositoryId", "sessionId", "replacements"],
  "properties": {
    "formatVersion": { "const": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "summary": { "$ref": "#/$defs/summary" },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["overview", "functions", "testsPerformed", "risks", "limitations"],
      "properties": {
        "overview": { "type": "string" },
        "functions": { "type": "array" },
        "testsPerformed": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "path": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).*\\.py$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content": {
      "oneOf": [
        { "required": ["replacement"], "not": { "required": ["replacementFile"] } },
        { "required": ["replacementFile"], "not": { "required": ["replacement"] } }
      ]
    },
    "common": {
      "type": "object",
      "required": ["operation", "path"],
      "properties": {
        "operation": { "enum": ["replace_function", "add_function", "add_file", "replace_file", "delete_file"] },
        "path": { "$ref": "#/$defs/path" },
        "qualifiedName": { "type": "string", "minLength": 1 },
        "originalHash": { "$ref": "#/$defs/hash" },
        "replacement": { "type": "string" },
        "replacementFile": { "type": "string", "minLength": 1 },
        "parentQualifiedName": { "type": "string" },
        "insertAfterQualifiedName": { "type": "string" },
        "allowAsyncChange": { "type": "boolean" },
        "allowDecoratorKindChange": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "change": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "oneOf": [
            {
              "properties": { "operation": { "const": "replace_function" } },
              "required": ["qualifiedName", "originalHash"],
              "$ref": "#/$defs/content"
            },
            {
              "properties": { "operation": { "const": "add_function" } },
              "required": ["qualifiedName", "parentQualifiedName"],
              "$ref": "#/$defs/content"
            },
            {
              "properties": { "operation": { "const": "add_file" } },
              "$ref": "#/$defs/content"
            },
            {
              "properties": { "operation": { "const": "replace_file" } },
              "required": ["originalHash"],
              "$ref": "#/$defs/content"
            },
            {
              "properties": { "operation": { "const": "delete_file" } },
              "required": ["originalHash"],
              "not": {
                "anyOf": [
                  { "required": ["replacement"] },
                  { "required": ["replacementFile"] }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
