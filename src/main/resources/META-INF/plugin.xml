<idea-plugin>
    <id>nl.ferron.copilot-context-bridge</id>
    <name>Copilot Context Bridge</name>
    <vendor url="https://github.com/MyDataIntelligence/pycharmToCopilot">MyDataIntelligence</vendor>

    <description><![CDATA[
      <p>Safely export repository context to Microsoft 365 Copilot and import complete Python function replacements.</p>
      <p>Includes dependency discovery, batch-aware staging, coding guidelines, secret protection, patch validation, diff preview, and undoable PSI replacements.</p>
    ]]></description>

    <change-notes><![CDATA[
      <h3>1.0.0</h3>
      <ul><li>Initial release.</li></ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>

    <resource-bundle>messages.CopilotContextBridgeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Copilot Context Bridge"
                    anchor="right"
                    factoryClass="nl.ferron.copilotcontextbridge.ui.CopilotContextToolWindowFactory"
                    icon="/icons/bridge.svg"/>
        <postStartupActivity implementation="nl.ferron.copilotcontextbridge.ui.OpenOnStartupActivity"/>
        <applicationService serviceImplementation="nl.ferron.copilotcontextbridge.settings.AppSettings"/>
        <projectService serviceImplementation="nl.ferron.copilotcontextbridge.settings.ProjectSettings"/>
        <projectService serviceImplementation="nl.ferron.copilotcontextbridge.state.ContextSelectionService"/>
        <projectService serviceImplementation="nl.ferron.copilotcontextbridge.context.ContextPackService"/>
        <applicationConfigurable id="nl.ferron.copilotcontextbridge.settings.application"
                                 displayName="Copilot Context Bridge"
                                 instance="nl.ferron.copilotcontextbridge.settings.AppSettingsConfigurable"/>
        <projectConfigurable id="nl.ferron.copilotcontextbridge.settings.project"
                             displayName="Copilot Context Bridge"
                             instance="nl.ferron.copilotcontextbridge.settings.ProjectSettingsConfigurable"/>
        <notificationGroup id="Copilot Context Bridge" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="CopilotContextBridge.Add"
                class="nl.ferron.copilotcontextbridge.actions.AddToContextAction"
                text="Add to Copilot Context"
                icon="/icons/bridge.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift A"/>
        </action>
        <action id="CopilotContextBridge.AddWithDependencies"
                class="nl.ferron.copilotcontextbridge.actions.AddWithDependenciesAction"
                text="Add with Dependencies"/>
        <action id="CopilotContextBridge.Remove"
                class="nl.ferron.copilotcontextbridge.actions.RemoveFromContextAction"
                text="Remove from Copilot Context"/>
        <action id="CopilotContextBridge.Open"
                class="nl.ferron.copilotcontextbridge.actions.OpenToolWindowAction"
                text="Open Copilot Context Bridge">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift C"/>
        </action>
        <action id="CopilotContextBridge.AddWithPromptSkill"
                class="nl.ferron.copilotcontextbridge.actions.AddWithPromptSkillAction"
                text="Add with Prompt Skill..."/>
        <action id="CopilotContextBridge.AddRepositoryStructure"
                class="nl.ferron.copilotcontextbridge.actions.AddRepositoryStructureAction"
                text="Add Repository Structure"/>
        <group id="CopilotContextBridge.ProjectViewGroup" text="Copilot Context Bridge" popup="false">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <reference ref="CopilotContextBridge.Add"/>
            <reference ref="CopilotContextBridge.AddWithDependencies"/>
            <reference ref="CopilotContextBridge.AddWithPromptSkill"/>
            <reference ref="CopilotContextBridge.Remove"/>
            <separator/>
            <reference ref="CopilotContextBridge.Open"/>
            <group id="CopilotContextBridge.ProjectViewMore" text="More Copilot actions" popup="true">
                <reference ref="CopilotContextBridge.AddRepositoryStructure"/>
            </group>
        </group>
    </actions>
</idea-plugin>
